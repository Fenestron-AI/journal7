# Database (PostgreSQL с pgvector)
DATABASE_URL=postgresql://journal7:journal7_dev@localhost:5432/journal7

# Yandex Cloud (https://console.yandex.cloud — сервисный аккаунт + Api-Key)
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_EMBEDDING_MODEL=text-search-doc
YANDEX_EMBEDDING_QUERY_MODEL=text-search-query
YANDEX_LLM_MODEL=yandexgpt/latest
YANDEX_LLM_TEMPERATURE=0.1
YANDEX_LLM_MAX_TOKENS=2000

# Ingestion
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
WATCH_DIR=/home/fenestron/Developer/journal7/data/legal-docs/current

# Vector search
TOP_K=6
SIMILARITY_THRESHOLD=0.35
